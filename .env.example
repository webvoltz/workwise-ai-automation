NODE_ENV=development

# "mock" runs every workflow against deterministic local fixtures — no API key, no network calls.
# Set to "openai" to route completions through the OpenAI API instead.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# How long a single provider call may take before it is treated as a timeout failure.
PROVIDER_TIMEOUT_MS=10000

# How many attempts a retryable workflow step gets before it is escalated to manual review.
MAX_RETRY_ATTEMPTS=3
