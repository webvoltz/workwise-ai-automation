{
  "name": "workwise-ai-automation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI automation workflows with structured outputs, validation, retries, RAG patterns, and tests.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/src/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "quality": "npm run format:check && npm run lint && npm run typecheck",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "security:audit": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
